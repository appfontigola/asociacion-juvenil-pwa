rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    function isActive() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if isAuth() && isActive();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isAuth() && isActive();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /attendance/{docId} {
      allow read: if isAuth() && isActive();
      allow create: if isAuth() && isActive() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuth() && isActive() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /localPresence/{userId} {
      allow read: if isAuth() && isActive();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    match /localLog/{docId} {
      allow read: if isAuth() && isActive();
      allow create: if isAuth() && isActive();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /keysLog/{docId} {
      allow read: if isAuth() && isActive();
      allow create: if isAuth() && isActive();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /alarmLog/{docId} {
      allow read: if isAuth() && isActive();
      allow create: if isAuth() && isActive();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payments/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /userBadges/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow write: if isAuth() && request.auth.uid == userId;
    }

    match /pushSubscriptions/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }
  }
}
